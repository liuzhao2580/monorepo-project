{
  "name": "@pmm/shared",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles/assets"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch"

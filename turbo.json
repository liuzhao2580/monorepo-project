{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "**/tsconfig*.json"
  ],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": [],
      "outputs": [],
      "cache": false,
      "persistent": true
    }
  }
}
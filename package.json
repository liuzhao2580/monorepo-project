{
  "name": "pmm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:vue": "pnpm --filter vue-app dev",
    "dev:react": "pnpm --filter react-admin-app dev",
    "dev:all": "concurrently \"pnpm run dev:server\" \"pnpm run dev:vue\" \"pnpm run dev:react\""
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}

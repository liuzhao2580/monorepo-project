{
  "name": "pmm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:vue": "pnpm --filter vue-app dev",
    "dev:react": "pnpm --filter react-admin-app dev",
    "dev:all": "concurrently \"pnpm run dev:server\" \"pnpm run dev:vue\" \"pnpm run dev:react\"",
    "catalog": "pnpx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.9.0"
  },
  "packageManager": "pnpm@9.9.0"
}

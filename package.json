{
  "name": "pmm-p",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:vue": "pnpm --filter vue-app dev",
    "dev:react": "pnpm --filter react-admin-app dev",
    "dev:all": "concurrently \"pnpm run dev:server\" \"pnpm run dev:vue\" \"pnpm run dev:react\"",
    "clean": "node ./scripts/clean.mjs",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "catalog": "pnpx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@pmm/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ]
  }
}
